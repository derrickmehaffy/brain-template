#!/usr/bin/env python3
"""Single entry point for the brain harness: `_meta/brain <command> ...`."""
# No `from __future__` import and no f-string here: an old Python must get as far as the version check.
import os
import sys

if sys.platform == "win32":
    sys.exit("brain: on Windows a brain runs inside WSL (Windows Subsystem for Linux): open the brain's folder "
             "from WSL and start Claude Code there.")
if sys.version_info < (3, 9):
    sys.exit("brain: this needs Python 3.9 or newer, and this computer's python3 is {}. Install a newer "
             "Python 3 (python.org), then try again.".format(sys.version.split()[0]))

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import brainlib.cli  # noqa: E402

sys.exit(brainlib.cli.main(sys.argv[1:]))
