{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "allow": [
      "Bash(_meta/brain doctor:*)",
      "Bash(_meta/brain lint:*)",
      "Bash(_meta/brain routing show:*)",
      "Bash(_meta/brain gate status:*)",
      "Bash(_meta/brain practices search:*)",
      "Bash(_meta/brain practices lint:*)",
      "Bash(_meta/brain upstream list:*)",
      "Bash(_meta/brain usage:*)",
      "Bash(_meta/brain env-sync --list:*)",
      "Bash(_meta/brain route:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/_meta/brain\" gate check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/_meta/brain\" gate record"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/_meta/brain\" doctor --brief"
          }
        ]
      }
    ]
  }
}
