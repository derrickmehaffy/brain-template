#!/usr/bin/env python3
"""Single entry point for the brain harness: `_meta/brain <command> ...`."""
from __future__ import annotations

import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import brainlib.cli  # noqa: E402

sys.exit(brainlib.cli.main(sys.argv[1:]))
